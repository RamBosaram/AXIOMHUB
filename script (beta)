            ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 90, 255)),
        })

        local startX = math.random(-100, 300) / 1000
        local startY = math.random(50, 400) / 1000
        local endX = startX + math.random(200, 500) / 1000
        local endY = startY + math.random(100, 300) / 1000

        star.Position = UDim2.new(startX, 0, startY, 0)
        local deltaY = endY - startY
        local deltaX = endX - startX
        star.Rotation = math.deg(math.atan2(deltaY, deltaX))

        local tween = TweenService:Create(star, TweenInfo.new(0.8, Enum.EasingStyle.Linear), {
            Position = UDim2.new(endX, 0, endY, 0),
            BackgroundTransparency = 1
        })
        tween:Play()
        tween.Completed:Connect(function() star:Destroy() end)
    end

    task.spawn(function()
        while bg.Parent do
