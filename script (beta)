local function openMenu()
    Menu.Visible = true
    Menu.Position = UDim2.new(0.5, 0, -0.6, 0)
    menuScale.Scale = 0.7
    TweenService:Create(Menu, TweenInfo.new(1.0, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
