local CONFIG_FILE = "AXIOM_MM2_config.json"
local BLACKLIST_KEYS = {
    hubOpen = true, floatingButtonsState = true,
    fly = true, noclip = true, touchFling = true,
    autoShoot = true, autoKnifeThrow = true, killAuraOn = true,
    silentThrowAim = true, invisible = true, cameraNoclip = true,
    infJump = true, streamProof = true,
}

local ConfigManager = {}
ConfigManager.loaded = {}
ConfigManager.saveTask = nil

function ConfigManager:load()
    if not readfile or not isfile then return end
    if not isfile(CONFIG_FILE) then return end
    local ok, content = pcall(readfile, CONFIG_FILE)
    if not ok or not content then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or type(data) ~= "table" then return end
    self.loaded = data
end

function ConfigManager:apply(t)
    for k, v in pairs(self.loaded) do
        if not BLACKLIST_KEYS[k] and t[k] ~= nil and type(v) == type(t[k]) then
            t[k] = v
        end
    end
end

function ConfigManager:save(t)
    if not writefile then return end
    if self.saveTask then task.cancel(self.saveTask) end
    self.saveTask = task.delay(1, function()
        local snap = {}
        for k, v in pairs(t) do
            if not BLACKLIST_KEYS[k] then snap[k] = v end
        end
        local ok, json = pcall(function() return HttpService:JSONEncode(snap) end)
        if ok then pcall(writefile, CONFIG_FILE, json) end
        self.saveTask = nil
    end)
end

ConfigManager:load()

