----------------------------------------------------------------
-- SILENT AIM — NAMECALL HOOK
----------------------------------------------------------------
-- This is the core fix. hookmetamethod on __namecall intercepts ALL
-- FireServer calls at the metamethod level — more reliable than
-- hookfunction on a specific FireServer reference.
local oldNamecall
local silentAimReady = false

local function setupSilentAim()
    if silentAimReady then return end
    local ok, err = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and State.silentThrowAim
               and typeof(self) == "Instance" and self.Name == "KnifeThrown" then
                local args = {...}
                if type(args[1]) == "string" and args[1] == "Throw" and #args >= 3 then
                    local target = nil
                    if State.knifeFOVEnabled then
                        target = getPlayerInKnifeFOV()
                    end
                    if not target then
                        target = findNearestPlayer()
                    end
                    if target and target.Character then
                        local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP then
                            if not State.murdererWallCheck or hasLineOfSight(target) then
                                local ok2, predicted = pcall(getKnifePredicted, target)
                                if ok2 and predicted and predicted ~= Vector3.zero then
                                    args[3] = CFrame.new(predicted)
                                end
                            end
                        end
                    end
                    return oldNamecall(self, table.unpack(args))
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
    if ok then
        silentAimReady = true
    else
        warn("[AXIOM] hookmetamethod failed: "..tostring(err))
        -- Fallback: hookfunction approach
        pcall(function()
            local knife = safeChar() and safeChar():FindFirstChild("Knife")
            if knife then
                local events = knife:FindFirstChild("Events")
                local remote = events and events:FindFirstChild("KnifeThrown")
                if remote then
                    local oldFS = remote.FireServer
                    local function newFS(self, ...)
                        local args = {...}
                        if State.silentThrowAim and type(args[1]) == "string" and args[1] == "Throw" and #args >= 3 then
                            local target = State.knifeFOVEnabled and getPlayerInKnifeFOV() or findNearestPlayer()
                            if target and target.Character then
                                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                                if tHRP and (not State.murdererWallCheck or hasLineOfSight(target)) then
                                    local ok3, pred = pcall(getKnifePredicted, target)
                                    if ok3 and pred and pred ~= Vector3.zero then
                                        args[3] = CFrame.new(pred)
                                    end
                                end
                            end
                        end
                        return oldFS(self, table.unpack(args))
                    end
                    hookfunction(remote.FireServer, newFS)
                    silentAimReady = true
                end
            end
        end)
    end
end

