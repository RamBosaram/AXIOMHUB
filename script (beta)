local function hasLineOfSight(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local hrp = safeHRP()
    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHRP then return false end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {safeChar()}
    local hit = workspace:Raycast(hrp.Position, targetHRP.Position - hrp.Position, rp)
    if not hit then return true end
    return hit.Instance:IsDescendantOf(targetPlayer.Character)
end

-- SILENT AIM
local oldNamecall
local silentAimReady = false
local function setupSilentAim()
    if silentAimReady then return end
    if not hookmetamethod then return end
    local closure = newcclosure or function(f) return f end
    local ok, err = pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", closure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and State.silentThrowAim
               and typeof(self) == "Instance" and self.Name == "KnifeThrown" then
                local args = {...}
                if type(args[1]) == "string" and args[1] == "Throw" and #args >= 3 then
                    local target = nil
                    if State.knifeFOVEnabled then target = getPlayerInKnifeFOV() end
                    if not target then target = findNearestPlayer() end
                    if target and target.Character then
                        local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP and (not State.murdererWallCheck or hasLineOfSight(target)) then
                            local ok2, predicted = pcall(getKnifePredicted, target)
                            if ok2 and predicted and predicted ~= Vector3.zero then
                                args[3] = CFrame.new(predicted)
                            end
                        end
                    end
                    return oldNamecall(self, table.unpack(args))
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
    if ok then silentAimReady = true else warn("[AXIOM] Silent aim failed: "..tostring(err)) end
end

