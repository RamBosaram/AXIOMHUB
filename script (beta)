    local track = Instance.new("Frame", frame)
    track.Position = UDim2.new(0, 10, 1, -14)
    track.Size = UDim2.new(1, -20, 0, 5)
    track.BackgroundColor3 = Theme.primary
    track.BorderSizePixel = 0
    track.Active = true
    track.ZIndex = 6
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.accent
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fillGrad = Instance.new("UIGradient", fill)
    fillGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.accentDeep),
        ColorSequenceKeypoint.new(1, Theme.accentAlt),
    })

    local function fmt(v)
        if step and step >= 1 then return tostring(math.floor(v)) else return string.format("%.2f", v) end
    end

    local function applyValue(value, silent)
        value = math.clamp(value, min, max)
        if step and step > 0 then value = math.floor(value / step + 0.5) * step end
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valueBox.Text = fmt(value)
        if not silent then
            if stateKey then State[stateKey] = value end
            pcall(callback, value)
            ConfigManager:save(State)
        end
    end

    valueBox.Text = fmt(default)

    valueBox.FocusLost:Connect(function()
        local n = tonumber(valueBox.Text)
        if not n then
            local rel = fill.Size.X.Scale
            local cur = min + (max - min) * rel
            if step and step > 0 then cur = math.floor(cur / step + 0.5) * step end
            valueBox.Text = fmt(cur)
            return
        end
        applyValue(n)
    end)

    local activeInput, startPos, engaged, engageTask
    local DRAG_THRESHOLD = 8

    local function updateFromInput(pos)
        local rel = math.clamp((pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        applyValue(min + (max - min) * rel)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if activeInput then return end
            activeInput = input
            startPos = input.Position
            engaged = false
            engageTask = task.delay(0.15, function()
                if activeInput == input and not engaged then
                    engaged = true
                    updateFromInput(input.Position)
                end
            end)
            local sc
            sc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sc:Disconnect()
                    if engageTask then task.cancel(engageTask) engageTask = nil end
                    if activeInput == input then activeInput = nil end
                    engaged = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input ~= activeInput then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not engaged then
            local delta = input.Position - startPos
            if math.abs(delta.Y) > math.abs(delta.X) and math.abs(delta.Y) > DRAG_THRESHOLD then
                activeInput = nil
                if engageTask then task.cancel(engageTask) engageTask = nil end
                return
            end
            if math.abs(delta.X) > DRAG_THRESHOLD then
                engaged = true
                if engageTask then task.cancel(engageTask) engageTask = nil end
            end
        end
        if engaged then updateFromInput(input.Position) end
    end)

    return row
end

