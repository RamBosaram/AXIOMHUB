local function shootMurderer(force)
    if findSheriff() ~= LocalPlayer and not force then
        notify("You are not sheriff.")
        return
    end
    local target = findMurderer() or (force and findNearestPlayer())
    if not target or not target.Character then
        notify("No target.")
        return
    end
    if State.sheriffWallCheck and not hasLineOfSight(target) and not force then
        return
    end
    local char = safeChar()
    local hum = safeHum()
    if not char or not hum then return end

    if not char:FindFirstChild("Gun") then
        local g = LocalPlayer.Backpack:FindFirstChild("Gun")
        if g then
            hum:EquipTool(g)
        else
            notify("No gun.")
            return
        end
    end

    local predicted = getSheriffPredicted(target)
    local gun = char:WaitForChild("Gun", 1)
    if gun and gun:FindFirstChild("Shoot") then
        local cam = workspace.CurrentCamera
        local originalCF = cam and cam.CFrame or nil
        if State.sheriffCameraTurn and cam then
            cam.CFrame = CFrame.new(cam.CFrame.Position, predicted)
        end
        gun.Shoot:FireServer(CFrame.new(char.RightHand.Position), CFrame.new(predicted))
        if State.sheriffCameraTurn and originalCF and cam then
            task.delay(0.033, function()
                if cam and cam.Parent then
                    cam.CFrame = originalCF
                end
            end)
        end
        if State.autoUnequipGun then
            task.delay(0.03, function()
                local h = safeHum()
                if h then h:UnequipTools() end
            end)
        end
    end
end

local function knifeThrow(silent)
    if findMurderer() ~= LocalPlayer then
        if not silent then notify("Not murderer.") end
        return
    end
    local target
    if State.knifeFOVEnabled then
        target = getPlayerInKnifeFOV()
        if not target then
            if silent then return end
            target = findNearestPlayer()
        end
    else
        target = findNearestPlayer()
    end
    if not target or not target.Character then return end
    if State.murdererWallCheck and not hasLineOfSight(target) then return end
    local char = safeChar()
    local hum = safeHum()
    if not char or not hum then return end
    if not char:FindFirstChild("Knife") then
        local k = LocalPlayer.Backpack:FindFirstChild("Knife")
        if k then
            hum:EquipTool(k)
        else
            return
        end
    end
    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local predicted = getKnifePredicted(target)
    local from = CFrame.new(char.RightHand.Position)
    if State.spawnKnifeAtPlayer then
        from = CFrame.new(tHRP.Position + (tHRP.CFrame.LookVector * 5))
    end
    local knife = char:WaitForChild("Knife", 1)
    local events = knife and knife:FindFirstChild("Events")
    if events and events:FindFirstChild("KnifeThrown") then
        events.KnifeThrown:FireServer("Throw", from, CFrame.new(predicted))
    end
end

