        ColorSequenceKeypoint.new(0.15, Color3.fromRGB(8, 5, 16)),
        ColorSequenceKeypoint.new(0.3, Color3.fromRGB(4, 3, 10)),
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(10, 7, 20)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(5, 3, 12)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(12, 8, 22)),
        ColorSequenceKeypoint.new(0.9, Color3.fromRGB(6, 4, 14)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 10, 26)),
    })
    bgGrad.Rotation = 90
    allElements[#allElements + 1] = bg

    -- Layer 1: Deep nebula (20 clouds)
    local nebColors = {
        Color3.fromRGB(70, 25, 110), Color3.fromRGB(35, 50, 130),
        Color3.fromRGB(110, 35, 90), Color3.fromRGB(50, 15, 80),
        Color3.fromRGB(25, 45, 100), Color3.fromRGB(90, 30, 120),
        Color3.fromRGB(40, 60, 140), Color3.fromRGB(80, 20, 100),
        Color3.fromRGB(30, 40, 110), Color3.fromRGB(100, 40, 130),
        Color3.fromRGB(45, 30, 90), Color3.fromRGB(60, 50, 120),
        Color3.fromRGB(55, 20, 85), Color3.fromRGB(25, 55, 115),
        Color3.fromRGB(95, 35, 115), Color3.fromRGB(35, 65, 125),
        Color3.fromRGB(75, 25, 95), Color3.fromRGB(50, 40, 100),
        Color3.fromRGB(85, 45, 105), Color3.fromRGB(40, 55, 130),
    }

    for i = 1, 20 do
        local cloud = Instance.new("Frame", bg)
        local sz = math.random(200, 600)
        cloud.Size = UDim2.fromOffset(sz, sz)
        cloud.Position = UDim2.new(
            math.random(-40, 100) / 100, 0,
            math.random(-40, 100) / 100, 0
        )
        cloud.BackgroundColor3 = nebColors[i]
        cloud.BackgroundTransparency = 0.88 + math.random() * 0.06
        cloud.BorderSizePixel = 0
        cloud.ZIndex = 1
        Instance.new("UICorner", cloud).CornerRadius = UDim.new(1, 0)

        local cg = Instance.new("UIGradient", cloud)
        cg.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.0),
            NumberSequenceKeypoint.new(0.3, 0.15),
            NumberSequenceKeypoint.new(0.7, 0.5),
            NumberSequenceKeypoint.new(1, 1.0),
        })
        cg.Rotation = math.random(0, 360)

        local startRot = cg.Rotation
        local startPos = cloud.Position

        task.spawn(function()
            while cloud.Parent do
                TweenService:Create(cloud, TweenInfo.new(
                    math.random(25, 50),
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.InOut
                ), {
                    Position = startPos + UDim2.new(
                        math.random(-40, 40) / 1000, 0,
                        math.random(-30, 30) / 1000, 0
                    )
                }):Play()

                TweenService:Create(cg, TweenInfo.new(
                    math.random(30, 60),
                    Enum.EasingStyle.Linear
                ), {
                    Rotation = startRot + math.random(-50, 50)
                }):Play()

                task.wait(math.random(25, 50))
            end
        end)

        allElements[#allElements + 1] = cloud
    end

    -- Layers 2-9: Star fields (8 layers)
    local function createStarsLayer(count, zIdx, sizeMin, sizeMax, transpMin, transpMax)
        for i = 1, count do
            local star = Instance.new("Frame", bg)
            local sz = math.random(sizeMin, sizeMax) / 10
            star.Size = UDim2.fromOffset(sz, sz)
            star.Position = UDim2.new(
                math.random(0, 1000) / 1000, 0,
                math.random(0, 1000) / 1000, 0
            )

            local hue = math.random()
            if hue < 0.55 then
                star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            elseif hue < 0.70 then
                star.BackgroundColor3 = Color3.fromRGB(200, 220, 255)
            elseif hue < 0.82 then
                star.BackgroundColor3 = Color3.fromRGB(255, 240, 200)
            elseif hue < 0.92 then
                star.BackgroundColor3 = Color3.fromRGB(255, 200, 150)
            else
                star.BackgroundColor3 = Color3.fromRGB(200, 180, 255)
            end

            star.BackgroundTransparency = math.random(transpMin, transpMax) / 100
            star.BorderSizePixel = 0
            star.ZIndex = zIdx
            Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)
            allElements[#allElements + 1] = star

            if sz >= 2.5 then
                local glow1 = Instance.new("Frame", bg)
                local g1sz = sz * (2 + math.random() * 2)
                glow1.Size = UDim2.fromOffset(g1sz, g1sz)
                glow1.Position = star.Position
                glow1.BackgroundColor3 = star.BackgroundColor3
                glow1.BackgroundTransparency = 0.82 + math.random() * 0.08
                glow1.BorderSizePixel = 0
                glow1.ZIndex = zIdx - 1
                Instance.new("UICorner", glow1).CornerRadius = UDim.new(1, 0)
                allElements[#allElements + 1] = glow1

                local glow2 = Instance.new("Frame", bg)
                glow2.Size = UDim2.fromOffset(g1sz * 1.8, g1sz * 1.8)
                glow2.Position = star.Position
                glow2.BackgroundColor3 = star.BackgroundColor3
                glow2.BackgroundTransparency = 0.93 + math.random() * 0.04
                glow2.BorderSizePixel = 0
                glow2.ZIndex = zIdx - 2
                Instance.new("UICorner", glow2).CornerRadius = UDim.new(1, 0)
                allElements[#allElements + 1] = glow2
            end
        end
    end

    createStarsLayer(60, 2, 5, 10, 40, 70)
    createStarsLayer(55, 3, 8, 14, 25, 50)
    createStarsLayer(50, 4, 10, 16, 18, 38)
    createStarsLayer(45, 5, 12, 18, 12, 28)
    createStarsLayer(40, 6, 14, 22, 8, 20)
    createStarsLayer(35, 7, 18, 28, 4, 14)
    createStarsLayer(30, 8, 22, 36, 0, 10)
    createStarsLayer(25, 9, 28, 45, 0, 6)

    -- Layer 10: Micro-stars (100)
    for i = 1, 100 do
        local micro = Instance.new("Frame", bg)
        micro.Size = UDim2.fromOffset(1, 1)
        micro.Position = UDim2.new(
            math.random(0, 1000) / 1000, 0,
            math.random(0, 1000) / 1000, 0
        )
        micro.BackgroundColor3 = Color3.fromRGB(200, 200, 220)
        micro.BackgroundTransparency = 0.4 + math.random() * 0.4
        micro.BorderSizePixel = 0
        micro.ZIndex = 5
        allElements[#allElements + 1] = micro
    end

    -- Layer 11: Dust particles (50)
    for i = 1, 50 do
        local dust = Instance.new("Frame", bg)
        local dsz = math.random(2, 6) / 10
        dust.Size = UDim2.fromOffset(dsz, dsz)
        dust.Position = UDim2.new(
            math.random(0, 1000) / 1000, 0,
            math.random(0, 1000) / 1000, 0
