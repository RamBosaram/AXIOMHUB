            elseif c < 0.8 then star.Color = Color3.fromRGB(200, 220, 255)
            elseif c < 0.9 then star.Color = Color3.fromRGB(255, 230, 200)
            else star.Color = Color3.fromRGB(255, 200, 150) end
            star.Material = Enum.Material.Neon
            star.Position = Vector3.new(math.random(-35, 35), math.random(-25, 25), math.random(-45, -12))
            star.Anchored = true
            star.Parent = viewport
            stars3D[#stars3D+1] = star
        end

        -- Camera orbit + animation
        local angle = 0
        task.spawn(function()
            while viewport.Parent do
                angle = angle + 0.0015
                local breath = math.sin(angle * 8) * 0.3
                local x = math.cos(angle) * 16
                local z = math.sin(angle) * 16
                local y = 4 + math.sin(angle * 0.3) * 2 + breath
                cam.CFrame = CFrame.new(Vector3.new(x, y, z), Vector3.new(0, 0, 0))
                planet.CFrame = CFrame.Angles(0, angle * 0.3, 0)
                atmos.CFrame = CFrame.Angles(0, angle * 0.3, 0)
                -- Rings: spin + tilt + horizontal
                for _, ring in ipairs(ringParts) do
                    ring.CFrame = CFrame.new(0, 0, 0)
                        * CFrame.Angles(0, angle * 0.3, 0)
                        * CFrame.Angles(TILT, 0, 0)
                        * CFrame.Angles(0, 0, math.rad(90))
                end
                moon.Position = Vector3.new(
                    math.cos(angle * 2.5) * 9,
                    math.sin(angle * 2.5) * 2,
                    math.sin(angle * 2.5) * 9
                )
                atmos.Transparency = 0.85 + math.sin(angle * 15) * 0.05
                for i = 1, 4 do
                    local idx = math.random(1, #stars3D)
                    local s = stars3D[idx]
                    if s and s.Parent then s.Transparency = math.random() * 0.6 end
                end
                task.wait(0.016)
            end
        end)
    end)

