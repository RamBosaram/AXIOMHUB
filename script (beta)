local fpsCount, fpsTimer = 0, tick()

RunService.RenderStepped:Connect(function()
    -- FPS counter
    fpsCount = fpsCount + 1
    local now = tick()
    if now - fpsTimer >= 1 then
        if State.fpsCounter then
            fpsLabel.Text = string.format("FPS: %d", fpsCount)
            fpsLabel.Visible = true
        else
            fpsLabel.Visible = false
        end
        fpsCount = 0
        fpsTimer = now
    end

    -- Check if any ESP is on
    local anyESP = State.hlAll or State.hlInnocent or State.hlMurderer or State.hlSheriff
        or State.box3DAll or State.box3DInnocent or State.box3DMurderer or State.box3DSheriff
        or State.box2DAll or State.box2DInnocent or State.box2DMurderer or State.box2DSheriff
        or State.tracerAll or State.tracerInnocent or State.tracerMurderer or State.tracerSheriff
        or State.showDistance or State.showNickname

    if not anyESP then
        for p, _ in pairs(PlayerESP.highlights) do
            removePlayerESP(p)
        end
    else
        local myHRP = safeHRP()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(0, 0)

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer and State.hideSelfESP then
                removePlayerESP(player)
                continue
            end
            if not player.Character then
                removePlayerESP(player)
                continue
            end

            local role = getPlayerRole(player)
            local alive = isPlayerAlive(player)
            if not alive then
                removePlayerESP(player)
                continue
            end

            local color = ROLE_COLORS[role] or ROLE_COLORS.Innocent

            -- Determine if ESP should show for this player
            local showHL = State.hlAll
                or (role == "Innocent" and State.hlInnocent)
                or (role == "Murderer" and State.hlMurderer)
                or (role == "Sheriff" and State.hlSheriff)
                or (role == "Hero" and State.hlSheriff)

            local showBox3D = State.box3DAll
                or (role == "Innocent" and State.box3DInnocent)
                or (role == "Murderer" and State.box3DMurderer)
                or (role == "Sheriff" and State.box3DSheriff)
                or (role == "Hero" and State.box3DSheriff)

            local showBox2D = State.box2DAll
                or (role == "Innocent" and State.box2DInnocent)
                or (role == "Murderer" and State.box2DMurderer)
                or (role == "Sheriff" and State.box2DSheriff)
                or (role == "Hero" and State.box2DSheriff)

            local showTracer = State.tracerAll
                or (role == "Innocent" and State.tracerInnocent)
                or (role == "Murderer" and State.tracerMurderer)
                or (role == "Sheriff" and State.tracerSheriff)
                or (role == "Hero" and State.tracerSheriff)

            local anyShow = showHL or showBox3D or showBox2D or showTracer
                or State.showDistance or State.showNickname

            if anyShow then
                -- Highlight
                if showHL then
                    local hl = PlayerESP.highlights[player] or createHighlight(player)
                    if hl then
                        hl.FillColor = color
                        hl.OutlineColor = lighten(color, 0.3)
                        hl.Adornee = player.Character
                    end
                else
                    if PlayerESP.highlights[player] then
                        PlayerESP.highlights[player]:Destroy()
                        PlayerESP.highlights[player] = nil
                    end
                end

                -- Distance + Nickname
                local needHUD = State.showDistance or State.showNickname
                if needHUD then
                    local hud = PlayerESP.huds[player] or createHUD(player)
                    if hud and hud.gui then
                        local head = player.Character:FindFirstChild("Head")
                        if head then
                            hud.gui.Adornee = head
                            hud.dist.Visible = State.showDistance
                            if State.showDistance then
                                hud.distStroke.Color = color
                                if myHRP then
                                    local d = (myHRP.Position - head.Position).Magnitude
                                    hud.dist.Text = string.format("%dm", math.floor(d))
                                end
                            end
                            hud.nick.Visible = State.showNickname
                            if State.showNickname then
                                hud.nickStroke.Color = color
                                hud.nick.Text = player.DisplayName
                            end
                        end
                    end
                else
                    if PlayerESP.huds[player] then
                        PlayerESP.huds[player].gui:Destroy()
                        PlayerESP.huds[player] = nil
                    end
                end

                -- 3D Box
                if showBox3D then
                    update3DBox(player, color)
                else
                    clear3DBox(player)
                end

                -- 2D Box
                if showBox2D then
                    update2DBox(player, color)
                else
                    clear2DBox(player)
                end

                -- Tracers
                if showTracer and cam and myHRP and Drawing then
                    local tHRP = player.Character:FindFirstChild("HumanoidRootPart")
                    if tHRP then
                        local sp, onScreen = cam:WorldToViewportPoint(tHRP.Position)
                        if onScreen then
                            if not PlayerESP.tracers[player] then
                                PlayerESP.tracers[player] = Drawing.new("Line")
                            end
                            local tracer = PlayerESP.tracers[player]
                            if tracer then
                                tracer.Thickness = 1
                                tracer.Color = color
                                tracer.Transparency = 1
                                tracer.From = Vector2.new(vp.X / 2, vp.Y)
                                tracer.To = Vector2.new(sp.X, sp.Y)
                                tracer.Visible = true
                            end
                        else
                            if PlayerESP.tracers[player] then
                                PlayerESP.tracers[player].Visible = false
                            end
                        end
                    end
                else
                    if PlayerESP.tracers[player] then
                        PlayerESP.tracers[player]:Remove()
                        PlayerESP.tracers[player] = nil
                    end
                end
            else
                removePlayerESP(player)
            end
        end
    end

    -- Object ESP arrows
    local camera = workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(0, 0)
    local hrp = safeHRP()
    for adornee, e in pairs(ObjectESP.entries) do
        if not adornee or not adornee.Parent then
            ObjectESP:remove(adornee)
        else
            local pos
            if adornee:IsA("Model") then
                pos = adornee.PrimaryPart and adornee.PrimaryPart.Position or adornee:GetPivot().Position
            elseif adornee:IsA("BasePart") then
                pos = adornee.Position
            end
            if pos and e.arrow then
                local screenPos, onScreen = camera:WorldToViewportPoint(pos)
                local dist = hrp and (hrp.Position - pos).Magnitude or 0
                if onScreen and dist < 30 then
                    e.arrow.Visible = false
                else
                    e.arrow.Visible = true
                    local padding = 60
                    local cx, cy = vp.X / 2, vp.Y / 2
                    local dx, dy = screenPos.X - cx, screenPos.Y - cy
                    if not onScreen then
                        dx, dy = -dx, -dy
                    end
                    local angle = math.atan2(dy, dx)
                    local cosA, sinA = math.cos(angle), math.sin(angle)
                    if math.abs(cosA) < 0.0001 then cosA = 0.0001 end
                    if math.abs(sinA) < 0.0001 then sinA = 0.0001 end
                    local px = cx + cosA * math.min(
                        math.abs((vp.X / 2 - padding) / cosA),
                        math.abs((vp.Y / 2 - padding) / sinA)
                    )
                    local py = cy + sinA * math.min(
                        math.abs((vp.X / 2 - padding) / cosA),
                        math.abs((vp.Y / 2 - padding) / sinA)
                    )
                    e.arrow.Position = UDim2.fromOffset(px, py)
                    e.arrow.Rotation = math.deg(angle) + 90
                    if e.distLabel then
                        e.distLabel.Text = string.format("%dm", math.floor(dist))
                    end
                end
            end
        end
    end

    -- FOV circle
    updateFOVCircle()

    -- Aimlock
    local isSheriff = findSheriff() == LocalPlayer
    local isMurderer = findMurderer() == LocalPlayer

    if isSheriff and State.sheriffAimlock then
        local murd = findMurderer()
        if murd and murd.Character then
            local tHRP = murd.Character:FindFirstChild("HumanoidRootPart")
            local mHRP = safeHRP()
            local cam = workspace.CurrentCamera
            if tHRP and mHRP and cam then
                cam.CFrame = CFrame.new(cam.CFrame.Position, tHRP.Position)
                mHRP.CFrame = CFrame.new(
                    mHRP.Position,
                    Vector3.new(tHRP.Position.X, mHRP.Position.Y, tHRP.Position.Z)
                )
            end
        end
    end

    if isMurderer and State.murdererAimlock then
        local target
        if State.aimlockActive and State.aimlockTarget and State.aimlockTarget.Character then
            target = State.aimlockTarget
        else
            target = findNearestPlayer()
        end
        if target and target.Character then
            local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
            local mHRP = safeHRP()
            local cam = workspace.CurrentCamera
            if tHRP and mHRP and cam then
                cam.CFrame = CFrame.new(cam.CFrame.Position, tHRP.Position)
                mHRP.CFrame = CFrame.new(
                    mHRP.Position,
                    Vector3.new(tHRP.Position.X, mHRP.Position.Y, tHRP.Position.Z)
                )
            end
        end
    end

    -- Loop WS/FOV
    if State.loopWSFOV then
        local cam = workspace.CurrentCamera
        local hum = safeHum()
        if cam then cam.FieldOfView = State.fov end
        if hum then hum.WalkSpeed = State.ws end
    end

    -- Crosshair
    Crosshair.Visible = State.crosshair

    -- Role reveal
    if State.roleReveal then
        local roles = RoleCache.data
        if roles then
            local myInfo = roles[LocalPlayer.Name]
            if myInfo and myInfo.Role and myInfo.Role ~= "Innocent" then
                roleRevealLabel.Text = "You are: " .. myInfo.Role
                roleRevealLabel.TextColor3 = ROLE_COLORS[myInfo.Role] or Theme.neon
            else
                roleRevealLabel.Text = ""
            end
        end
    else
        roleRevealLabel.Text = ""
    end

    -- Round timer
    if State.roundTimer then
        local part = workspace:FindFirstChild("RoundTimerPart")
        if part then
            local t = part:GetAttribute("Time")
            if t and t > 0 then
                roundTimerLabel.Text = string.format("%dm %ds", math.floor(t / 60), t % 60)
            else
                roundTimerLabel.Text = ""
            end
        else
            roundTimerLabel.Text = ""
        end
    else
        roundTimerLabel.Text = ""
    end
end)

