    ring1.Position = Vector3.new(0, 0, 0)
    ring1.Anchored = true
    ring1.Parent = viewport

    -- Saturn inner ring
    local ring2 = Instance.new("Part")
    ring2.Shape = Enum.PartType.Cylinder
    ring2.Size = Vector3.new(0.1, 11, 11)
    ring2.Color = Color3.fromRGB(200, 170, 120)
    ring2.Material = Enum.Material.Neon
    ring2.Transparency = 0.3
    ring2.Orientation = Vector3.new(15, 0, 0)
    ring2.Position = Vector3.new(0, 0, 0)
    ring2.Anchored = true
    ring2.Parent = viewport

    -- Moon
    local moon = Instance.new("Part")
    moon.Shape = Enum.PartType.Ball
    moon.Size = Vector3.new(1.5, 1.5, 1.5)
    moon.Color = Color3.fromRGB(180, 180, 190)
    moon.Material = Enum.Material.Neon
    moon.Position = Vector3.new(12, 4, -5)
    moon.Anchored = true
    moon.Parent = viewport

    -- Distant planet (purple)
    local planet = Instance.new("Part")
    planet.Shape = Enum.PartType.Ball
    planet.Size = Vector3.new(2.5, 2.5, 2.5)
    planet.Color = Color3.fromRGB(100, 60, 140)
    planet.Material = Enum.Material.Neon
    planet.Position = Vector3.new(-25, 8, -35)
    planet.Anchored = true
    planet.Parent = viewport

    -- Stars
    local stars = {}
    for i = 1, 40 do
        local star = Instance.new("Part")
        star.Shape = Enum.PartType.Ball
        local sz = math.random() * 0.2 + 0.08
        star.Size = Vector3.new(sz, sz, sz)
        star.Color = Color3.fromRGB(255, 255, 255)
        star.Material = Enum.Material.Neon
        star.Position = Vector3.new(
            math.random(-50, 50),
            math.random(-30, 30),
            math.random(-60, -15)
        )
        star.Anchored = true
        star.Parent = viewport
        stars[#stars+1] = star
    end

    -- Camera orbit + rotation animation
    local angle = 0
    task.spawn(function()
        while viewport.Parent do
            angle = angle + 0.002
            local x = math.cos(angle) * 22
            local z = math.sin(angle) * 22
            local y = 3 + math.sin(angle * 0.3) * 4
            cam.CFrame = CFrame.new(Vector3.new(x, y, z), Vector3.new(0, 0, 0))
            saturn.CFrame = CFrame.Angles(0, angle * 0.3, 0)
            ring1.CFrame = CFrame.Angles(math.rad(15), angle * 0.3, 0)
            ring2.CFrame = CFrame.Angles(math.rad(15), angle * 0.3, 0)
            moon.Position = Vector3.new(
                math.cos(angle * 2) * 14,
                math.sin(angle * 2) * 3,
                math.sin(angle * 2) * 14
            )
