local function safeClick(target, onClick)
    target.Active = true
    local activeInput = nil
    target.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if activeInput then return end
            activeInput = input
            local sc
            sc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sc:Disconnect()
                    if activeInput == input then
                        activeInput = nil
                        local pos = input.Position
                        local ap = target.AbsolutePosition
                        local as = target.AbsoluteSize
                        if pos.X >= ap.X and pos.X <= ap.X + as.X
                        and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
                            local ok, err = pcall(onClick)
                            if not ok then notify("Error: "..tostring(err), Theme.danger) end
                        end
                    end
                end
            end)
        end
    end)
end

local function makeDraggable(frame, handle)
    handle = handle or frame
    handle.Active = true
    local ai, ds, sp
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if ai then return end
            ai = input
            ds = input.Position
            sp = frame.Position
            local sc
            sc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sc:Disconnect()
                    if ai == input then ai = nil end
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input ~= ai then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - ds
        frame.Position = UDim2.new(
            sp.X.Scale, sp.X.Offset + delta.X,
            sp.Y.Scale, sp.Y.Offset + delta.Y
        )
    end)
end

