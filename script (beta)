        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(5, 3, 12)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(12, 8, 22)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 4, 14)),
    })
    bgGrad.Rotation = 90

    -- Nebula clouds
    local nebColors = {
        Color3.fromRGB(70, 25, 110), Color3.fromRGB(35, 50, 130),
        Color3.fromRGB(110, 35, 90), Color3.fromRGB(50, 15, 80),
        Color3.fromRGB(25, 45, 100), Color3.fromRGB(90, 30, 120),
        Color3.fromRGB(40, 60, 140),
    }
    for i = 1, 7 do
        local cloud = Instance.new("Frame", bg)
        local sz = math.random(250, 500)
        cloud.Size = UDim2.fromOffset(sz, sz)
        cloud.Position = UDim2.new(math.random(-30, 90) / 100, 0, math.random(-30, 90) / 100, 0)
        cloud.BackgroundColor3 = nebColors[i]
        cloud.BackgroundTransparency = 0.9
        cloud.BorderSizePixel = 0
        cloud.ZIndex = 1
        Instance.new("UICorner", cloud).CornerRadius = UDim.new(1, 0)
        local cg = Instance.new("UIGradient", cloud)
        cg.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.0),
            NumberSequenceKeypoint.new(0.4, 0.3),
            NumberSequenceKeypoint.new(1, 1.0),
        })
        cg.Rotation = math.random(0, 360)
        local sr = cg.Rotation
        local sp = cloud.Position
        task.spawn(function()
            while cloud.Parent do
                TweenService:Create(cloud, TweenInfo.new(math.random(20, 40), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Position = sp + UDim2.new(math.random(-30, 30) / 1000, 0, math.random(-20, 20) / 1000, 0)
                }):Play()
                TweenService:Create(cg, TweenInfo.new(math.random(25, 50), Enum.EasingStyle.Linear), {
                    Rotation = sr + math.random(-40, 40)
                }):Play()
                task.wait(math.random(20, 40))
            end
        end)
    end

    -- Star field — 5 layers
    local function makeStars(count, z, sMin, sMax, tMin, tMax)
        for i = 1, count do
            local star = Instance.new("Frame", bg)
            local sz = math.random(sMin, sMax) / 10
            star.Size = UDim2.fromOffset(sz, sz)
            star.Position = UDim2.new(math.random(0, 1000) / 1000, 0, math.random(0, 1000) / 1000, 0)
            local h = math.random()
            if h < 0.6 then star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            elseif h < 0.75 then star.BackgroundColor3 = Color3.fromRGB(200, 220, 255)
            elseif h < 0.88 then star.BackgroundColor3 = Color3.fromRGB(255, 240, 200)
            elseif h < 0.95 then star.BackgroundColor3 = Color3.fromRGB(255, 200, 150)
            else star.BackgroundColor3 = Color3.fromRGB(200, 180, 255) end
            star.BackgroundTransparency = math.random(tMin, tMax) / 100
            star.BorderSizePixel = 0
            star.ZIndex = z
            Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)
            stars[#stars+1] = star
            if sz >= 2.5 then
                local glow = Instance.new("Frame", bg)
                glow.Size = UDim2.fromOffset(sz * 3, sz * 3)
                glow.Position = star.Position
                glow.BackgroundColor3 = star.BackgroundColor3
                glow.BackgroundTransparency = 0.85
                glow.BorderSizePixel = 0
                glow.ZIndex = z - 1
                Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)
                stars[#stars+1] = glow
            end
        end
    end
    makeStars(50, 2, 6, 12, 35, 65)
    makeStars(35, 3, 10, 16, 20, 45)
    makeStars(25, 4, 14, 22, 10, 30)
    makeStars(15, 5, 18, 28, 5, 20)
