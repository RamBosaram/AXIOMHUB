local FloatingLayer = Instance.new("Frame", ScreenGui)
FloatingLayer.Name = "FloatingLayer"
FloatingLayer.Size = UDim2.new(1, 0, 1, 0)
FloatingLayer.BackgroundTransparency = 1
FloatingLayer.ZIndex = 8

local floatingButtons = {}

local function makeFloatingButton(label, callback, isBig)
    if floatingButtons[label] then
        floatingButtons[label]:Destroy()
        floatingButtons[label] = nil
        return
    end

    local size = isBig and 50 or 36
    local count = 0
    for _ in pairs(floatingButtons) do count = count + 1 end

    local btn = Instance.new("TextButton", FloatingLayer)
    btn.Size = UDim2.fromOffset(size, size)
    btn.Position = UDim2.new(1, -(size + 14), 0.5, 20 + count * (size + 8))
    btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    btn.BackgroundTransparency = 0.15
    btn.BorderSizePixel = 0
    btn.Text = label
    btn.Font = isBig and Enum.Font.GothamBold or Theme.font
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = isBig and 10 or 8
    btn.AutoButtonColor = false
    btn.ZIndex = 8
    btn.ClipsDescendants = true
    btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.5
    stroke.Color = Color3.new(1, 1, 1)
    local sg = Instance.new("UIGradient", stroke)
    sg.Color = Theme.strokeGrad
    sg.Rotation = 45

    local scale = Instance.new("UIScale", btn)
    scale.Scale = 0
    TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1
    }):Play()

    -- Multi-touch safe: drag or click
    local activeInput, dragStart, startPos, moved
    local DRAG_THRESHOLD = 8
    local longPressTask

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if activeInput then return end
            activeInput = input
            dragStart = input.Position
            startPos = btn.Position
            moved = false
            if input.UserInputType == Enum.UserInputType.Touch then
                longPressTask = task.delay(1.5, function()
                    if floatingButtons[label] and not moved then
                        floatingButtons[label]:Destroy()
                        floatingButtons[label] = nil
                    end
                end)
            end
            local sc
            sc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sc:Disconnect()
                    if longPressTask then task.cancel(longPressTask) longPressTask = nil end
                    if not moved and activeInput == input then
                        Sounds:play("click")
                        TweenService:Create(scale, TweenInfo.new(0.08), {Scale = 0.9}):Play()
                        task.delay(0.08, function()
                            TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                        end)
                        local ok, err = pcall(callback, btn)
                        if not ok then notify("Error: "..tostring(err), Theme.danger) end
                    end
                    activeInput = nil
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input ~= activeInput then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
            moved = true
            if longPressTask then task.cancel(longPressTask) longPressTask = nil end
        end
        if moved then
            btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    btn.MouseButton2Click:Connect(function()
        if floatingButtons[label] then
            floatingButtons[label]:Destroy()
            floatingButtons[label] = nil
        end
    end)

    floatingButtons[label] = btn
end

