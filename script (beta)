local function buildSpaceBackground(parent)
    local stars = {}
    local nebulae = {}
    local shootingStarTimer = 0

    -- Deep gradient base
    local bg = Instance.new("Frame", parent)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(8, 5, 15)
    bg.BorderSizePixel = 0
    bg.ZIndex = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 14)

    local bgGrad = Instance.new("UIGradient", bg)
    bgGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(5, 3, 12)),
        ColorSequenceKeypoint.new(0.3, Color3.fromRGB(12, 8, 22)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(8, 5, 18)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 10, 28)),
    })
    bgGrad.Rotation = 90

    -- Nebula clouds (5 drifting layers)
    local nebulaColors = {
        Color3.fromRGB(80, 30, 120),
        Color3.fromRGB(40, 60, 140),
        Color3.fromRGB(120, 40, 100),
        Color3.fromRGB(60, 20, 90),
        Color3.fromRGB(30, 50, 110),
    }
    for i = 1, 5 do
        local cloud = Instance.new("Frame", bg)
        local sz = math.random(200, 400)
        cloud.Size = UDim2.fromOffset(sz, sz)
        cloud.Position = UDim2.new(math.random(-20, 80) / 100, 0, math.random(-20, 80) / 100, 0)
        cloud.BackgroundColor3 = nebulaColors[i]
        cloud.BackgroundTransparency = 0.88
        cloud.BorderSizePixel = 0
        cloud.ZIndex = 1
        Instance.new("UICorner", cloud).CornerRadius = UDim.new(1, 0)

        local cloudGrad = Instance.new("UIGradient", cloud)
        cloudGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.0),
            NumberSequenceKeypoint.new(0.4, 0.2),
            NumberSequenceKeypoint.new(1, 1.0),
        })
        cloudGrad.Rotation = math.random(0, 360)

        local startRot = cloudGrad.Rotation
        task.spawn(function()
            while cloud.Parent do
                local driftX = math.random(-30, 30) / 1000
                local driftY = math.random(-20, 20) / 1000
                TweenService:Create(cloud, TweenInfo.new(math.random(15, 30), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Position = cloud.Position + UDim2.new(driftX, 0, driftY, 0)
                }):Play()
                TweenService:Create(cloudGrad, TweenInfo.new(math.random(20, 40), Enum.EasingStyle.Linear), {
                    Rotation = startRot + math.random(-30, 30)
                }):Play()
                task.wait(math.random(15, 30))
            end
        end)

        nebulae[#nebulae+1] = cloud
    end

    -- Star field — 3 parallax layers
    local function createStarsLayer(count, zIdx, sizeRange, transpRange)
        local layer = {}
        for i = 1, count do
            local star = Instance.new("Frame", bg)
            local sz = math.random(sizeRange[1], sizeRange[2]) / 10
            star.Size = UDim2.fromOffset(sz, sz)
            star.Position = UDim2.new(math.random(0, 1000) / 1000, 0, math.random(0, 1000) / 1000, 0)
            local hue = math.random()
            if hue < 0.7 then
                star.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            elseif hue < 0.85 then
                star.BackgroundColor3 = Color3.fromRGB(200, 220, 255)
            else
                star.BackgroundColor3 = Color3.fromRGB(255, 240, 200)
            end
            star.BackgroundTransparency = math.random(transpRange[1], transpRange[2]) / 100
            star.BorderSizePixel = 0
            star.ZIndex = zIdx
            Instance.new("UICorner", star).CornerRadius = UDim.new(1, 0)
            layer[#layer+1] = star
            stars[#stars+1] = star
        end
        return layer
    end

    local deepStars = createStarsLayer(40, 2, {8, 15}, {30, 60})
    local midStars = createStarsLayer(25, 3, {12, 20}, {15, 40})
    local nearStars = createStarsLayer(15, 4, {18, 30}, {5, 25})

