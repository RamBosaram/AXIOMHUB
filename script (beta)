        allElements[#allElements + 1] = dust

        local dustStart = dust.Position
        task.spawn(function()
            while dust.Parent do
                TweenService:Create(dust, TweenInfo.new(
                    math.random(15, 35),
                    Enum.EasingStyle.Sine,
