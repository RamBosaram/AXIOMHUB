local Pages = {}
local currentPage = nil

local function makeTab(name, order)
    local btn = Instance.new("TextButton", TabBar)
    btn.Name = name.."Tab"
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(28, 24, 38)
    btn.BackgroundTransparency = 0.1
    btn.BorderSizePixel = 0
    btn.Text = name
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Theme.textDim
    btn.TextSize = 13
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    -- Active indicator (left bar)
    local indicator = Instance.new("Frame", btn)
    indicator.AnchorPoint = Vector2.new(0, 0.5)
    indicator.Position = UDim2.new(0, 0, 0.5, 0)
    indicator.Size = UDim2.fromOffset(3, 0)
    indicator.BackgroundColor3 = Theme.accent
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 2
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

    -- Gradient background
    local btnGrad = Instance.new("UIGradient", btn)
    btnGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 16, 28)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 12, 18)),
    })
    btnGrad.Rotation = 90

    -- Container for this tab
    local container = Instance.new("Frame", Content)
    container.Name = name.."Container"
    container.Size = UDim2.new(1, -16, 1, -16)
    container.Position = UDim2.new(0, 8, 0, 8)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.ZIndex = 10

    -- Left column
    local left = Instance.new("ScrollingFrame", container)
    left.Size = UDim2.new(0.48, -2, 1, 0)
    left.Position = UDim2.new(0, 0, 0, 0)
    left.BackgroundTransparency = 1
    left.ScrollBarThickness = 2
    left.ScrollBarImageColor3 = Theme.accent
    left.AutomaticCanvasSize = Enum.AutomaticSize.Y
    left.CanvasSize = UDim2.new(0, 0, 0, 0)
    left.ZIndex = 10
    local ll = Instance.new("UIListLayout", left)
    ll.Padding = UDim.new(0, 6)
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.HorizontalAlignment = Enum.HorizontalAlignment.Center

    -- Right column
    local right = Instance.new("ScrollingFrame", container)
    right.Size = UDim2.new(0.48, -2, 1, 0)
    right.Position = UDim2.new(0.52, 0, 0, 0)
    right.BackgroundTransparency = 1
    right.ScrollBarThickness = 2
    right.ScrollBarImageColor3 = Theme.accent
    right.AutomaticCanvasSize = Enum.AutomaticSize.Y
    right.CanvasSize = UDim2.new(0, 0, 0, 0)
    right.ZIndex = 10
    local rl = Instance.new("UIListLayout", right)
    rl.Padding = UDim.new(0, 6)
    rl.SortOrder = Enum.SortOrder.LayoutOrder
    rl.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local pd = {
        button = btn, container = container,
        left = left, right = right,
        order = 0, indicator = indicator
    }

    -- Hover effects
    btn.MouseEnter:Connect(function()
        if currentPage ~= name then
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(35, 28, 48),
                BackgroundTransparency = 0.05
            }):Play()
            TweenService:Create(btn, TweenInfo.new(0.2), {TextColor3 = Theme.text}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if currentPage ~= name then
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(28, 24, 38),
                BackgroundTransparency = 0.1
            }):Play()
            TweenService:Create(btn, TweenInfo.new(0.2), {TextColor3 = Theme.textDim}):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        Sounds:play("tab")
        for _, p in pairs(Pages) do
            p.container.Visible = false
            TweenService:Create(p.button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(28, 24, 38),
                BackgroundTransparency = 0.1
            }):Play()
            TweenService:Create(p.button, TweenInfo.new(0.2), {TextColor3 = Theme.textDim}):Play()
            TweenService:Create(p.indicator, TweenInfo.new(0.2), {Size = UDim2.fromOffset(3, 0)}):Play()
        end
        container.Visible = true
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Theme.accentDeep,
            BackgroundTransparency = 0
        }):Play()
        TweenService:Create(btn, TweenInfo.new(0.2), {TextColor3 = Theme.neon}):Play()
        TweenService:Create(indicator, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(3, 20)
        }):Play()

        -- Page slide-in animation
        left.Position = UDim2.new(0, 10, 0, 0)
        right.Position = UDim2.new(0.52, 10, 0, 0)
        left.Visible = false
        right.Visible = false
        task.wait(0.02)
        left.Visible = true
        right.Visible = true
        TweenService:Create(left, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0)
        }):Play()
        TweenService:Create(right, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.52, 0, 0, 0)
        }):Play()

        currentPage = name
    end)

    Pages[name] = pd
    return pd
end

