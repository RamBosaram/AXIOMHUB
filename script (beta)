local function applyHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        if State.aggressiveHitbox then
            for _, part in ipairs(p.Character:GetChildren()) do
                if part:IsA("BasePart") then
                    if State.hitboxExpand == 1 then
                        part.Size = Vector3.new(2, 1, 1)
                    else
                        part.Size = Vector3.new(State.hitboxExpand, State.hitboxExpand, State.hitboxExpand)
                    end
                    part.Transparency = 0.2
                end
            end
        else
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if r then
                if State.hitboxExpand == 1 then
                    r.Size = Vector3.new(2, 1, 1)
                else
                    r.Size = Vector3.new(State.hitboxExpand, State.hitboxExpand, State.hitboxExpand)
                end
                r.Transparency = 0.2
                r.CanCollide = false
            end
        end
    end
end

