local function addSlider(pageData, text, min, max, default, step, callback)
    local box = Instance.new("Frame", pageData.page)
    box.Size = UDim2.new(1, -6, 0, 48)
    pageData.order = pageData.order + 1
    box.LayoutOrder = pageData.order
    box.ZIndex = 15
    styleBox(box)

    local lbl = Instance.new("TextLabel", box)
    lbl.Position = UDim2.new(0, 8, 0, 4)
    lbl.Size = UDim2.new(1, -68, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = string.upper(text)
    lbl.TextColor3 = Theme.neon
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 16

    local valueBox = Instance.new("TextBox", box)
    valueBox.AnchorPoint = Vector2.new(1, 0)
    valueBox.Position = UDim2.new(1, -8, 0, 3)
    valueBox.Size = UDim2.fromOffset(50, 18)
    valueBox.BackgroundColor3 = Theme.primary
    valueBox.BorderSizePixel = 0
    valueBox.Font = Enum.Font.GothamMedium
    valueBox.TextColor3 = Theme.accentAlt
    valueBox.TextSize = 11
    valueBox.ClearTextOnFocus = true
    valueBox.ZIndex = 16
    Instance.new("UICorner", valueBox).CornerRadius = UDim.new(0, 4)
    local vbs = Instance.new("UIStroke", valueBox)
    vbs.Color = Theme.accentDeep
    vbs.Thickness = 1
    vbs.Transparency = 0.3

    local track = Instance.new("Frame", box)
    track.Position = UDim2.new(0, 8, 1, -14)
    track.Size = UDim2.new(1, -16, 0, 5)
    track.BackgroundColor3 = Theme.primary
    track.BorderSizePixel = 0
    track.Active = true
    track.ZIndex = 16
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.accent
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fg = Instance.new("UIGradient", fill)
    fg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.accentDeep),
        ColorSequenceKeypoint.new(0.5, Theme.accent),
        ColorSequenceKeypoint.new(1, Theme.accentAlt),
    })

    local function fmt(v)
        if step and step >= 1 then
            return tostring(math.floor(v))
        else
            return string.format("%.2f", v)
        end
    end

    local function applyValue(value, silent)
        value = math.clamp(value, min, max)
        if step and step > 0 then
            value = math.floor(value / step + 0.5) * step
        end
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valueBox.Text = fmt(value)
        if not silent then
            if callback then
                pcall(callback, value)
            end
        end
    end

    valueBox.Text = fmt(default)

    valueBox.FocusLost:Connect(function()
        local n = tonumber(valueBox.Text)
        if not n then
            local rel = fill.Size.X.Scale
            local cur = min + (max - min) * rel
            if step and step > 0 then
                cur = math.floor(cur / step + 0.5) * step
            end
            valueBox.Text = fmt(cur)
            return
        end
        applyValue(n)
    end)

    local ai, sp, eng, et
    local function ufi(pos)
        local rel = math.clamp((pos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        applyValue(min + (max - min) * rel)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if ai then return end
            ai = input
            sp = input.Position
            eng = false
            et = task.delay(0.15, function()
                if ai == input and not eng then
                    eng = true
                    ufi(input.Position)
                end
            end)
            local sc
            sc = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sc:Disconnect()
                    if et then task.cancel(et) et = nil end
                    if ai == input then ai = nil end
                    eng = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input ~= ai then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if not eng then
            local delta = input.Position - sp
            if math.abs(delta.Y) > math.abs(delta.X) and math.abs(delta.Y) > 8 then
                ai = nil
                if et then task.cancel(et) end
                return
            end
            if math.abs(delta.X) > 8 then
                eng = true
                if et then task.cancel(et) end
            end
        end
        if eng then ufi(input.Position) end
    end)

    return box
end

