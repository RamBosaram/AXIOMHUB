    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", track)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.Size = UDim2.fromOffset(10, 10)
    knob.BackgroundColor3 = Color3.new(0.5, 0.5, 0.6)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = default or false
    if stateKey and State[stateKey] ~= nil then
        state = State[stateKey]
    end

    local function refresh()
        if state then
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, -12, 0.5, 0),
                BackgroundColor3 = Theme.accent
            }):Play()
            TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3 = Theme.accentDeep}):Play()
        else
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 2, 0.5, 0),
                BackgroundColor3 = Color3.new(0.5, 0.5, 0.6)
            }):Play()
            TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3 = Theme.primary}):Play()
        end
    end
    refresh()

    if stateKey and State[stateKey] == true then
        task.spawn(function()
            local ok, err = pcall(callback, true)
            if not ok then warn("[AXIOM] toggle init: " .. tostring(err)) end
        end)
    end

    local function flip()
        state = not state
        refresh()
        Sounds:play(state and "toggleOn" or "toggleOff")
        if stateKey then State[stateKey] = state end
        local ok, err = pcall(callback, state)
        if not ok then notify("Error: " .. tostring(err), Theme.danger) end
        ConfigManager:save(State)
    end

    row.Active = true
    safeClick(row, flip)
    return row
end

